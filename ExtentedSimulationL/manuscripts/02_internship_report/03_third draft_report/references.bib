@article{hoijtink_tutorial_2019,
	address = {US},
	title = {A tutorial on testing hypotheses using the {Bayes} factor},
	volume = {24},
	issn = {1939-1463},
	doi = {10.1037/met0000201},
	abstract = {Learning about hypothesis evaluation using the Bayes factor could enhance psychological research. In contrast to null-hypothesis significance testing it renders the evidence in favor of each of the hypotheses under consideration (it can be used to quantify support for the null-hypothesis) instead of a dichotomous reject/do-not-reject decision; it can straightforwardly be used for the evaluation of multiple hypotheses without having to bother about the proper manner to account for multiple testing; and it allows continuous reevaluation of hypotheses after additional data have been collected (Bayesian updating). This tutorial addresses researchers considering to evaluate their hypotheses by means of the Bayes factor. The focus is completely applied and each topic discussed is illustrated using Bayes factors for the evaluation of hypotheses in the context of an ANOVA model, obtained using the R package bain. Readers can execute all the analyses presented while reading this tutorial if they download bain and the R-codes used. It will be elaborated in a completely nontechnical manner: what the Bayes factor is, how it can be obtained, how Bayes factors should be interpreted, and what can be done with Bayes factors. After reading this tutorial and executing the associated code, researchers will be able to use their own data for the evaluation of hypotheses by means of the Bayes factor, not only in the context of ANOVA models, but also in the context of other statistical models. (PsycInfo Database Record (c) 2025 APA, all rights reserved)},
	number = {5},
	journal = {Psychological Methods},
	publisher = {American Psychological Association},
	author = {Hoijtink, Herbert and Mulder, Joris and van Lissa, Caspar and Gu, Xin},
	year = {2019},
	keywords = {Analysis of Variance, Errors, Hypothesis Testing, Null Hypothesis Testing, Statistical Probability, Statistical Significance},
	pages = {539--556},
	file = {Hoijtink2019_BFtutorial:/Users/loesjeubbink/Zotero/storage/9FCR4XM4/Hoijtink2019_BFtutorial.pdf:application/pdf;Preprint PDF:/Users/loesjeubbink/Zotero/storage/X4HG8BAY/Hoijtink e.a. - 2019 - A tutorial on testing hypotheses using the Bayes factor.pdf:application/pdf;Snapshot:/Users/loesjeubbink/Zotero/storage/Q2ZSATHQ/doiLanding.html:text/html},
}

